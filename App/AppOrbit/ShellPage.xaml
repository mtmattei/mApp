<Page x:Class="AppOrbit.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource Paper}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource TopBarHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TopBar" Padding="16,0" ColumnSpacing="16" BorderBrush="{ThemeResource Rule}" BorderThickness="0,0,0,1">
      <TextBlock Text="App Orbit" Style="{StaticResource T13}" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>

    <Grid x:Name="Shell" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource EditorWidth}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="{StaticResource InspectorWidth}" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Editor" Background="{ThemeResource Paper2}" BorderBrush="{ThemeResource Rule}" BorderThickness="0,0,1,0" />
      <Border x:Name="ViewerSlot" Grid.Column="1" />
      <Border x:Name="Inspector" Grid.Column="2" Background="{ThemeResource Paper2}" BorderBrush="{ThemeResource Rule}" BorderThickness="1,0,0,0" />
    </Grid>
  </Grid>
</Page>
