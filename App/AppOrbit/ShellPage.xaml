<Page x:Class="AppOrbit.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:scene="using:AppOrbit.Scene"
      xmlns:local="using:AppOrbit"
      Background="{ThemeResource Paper}">

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource TopBarHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ========== top bar: brand · breadcrumb · search · lens tabs · toggles ========== -->
    <Grid x:Name="TopBar" Padding="16,0" ColumnSpacing="16" BorderBrush="{ThemeResource Rule}" BorderThickness="0,0,0,1" Background="{ThemeResource Paper}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="160" />
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Grid Width="14" Height="14">
          <Ellipse Stroke="{ThemeResource Ink}" StrokeThickness="1.5" />
          <Ellipse Stroke="{ThemeResource Ink3}" StrokeThickness="1" Width="20" Height="7" Margin="-3,0" />
        </Grid>
        <TextBlock Text="App Orbit" Style="{StaticResource T13}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel x:Name="Breadcrumb" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />

      <Grid Grid.Column="2" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" IsTabStop="True" TabIndex="5" PlaceholderText="Search entities  /" AutomationProperties.Name="Search entities" />
        <Popup x:Name="SearchPopup" IsLightDismissEnabled="False" VerticalOffset="32">
          <Border x:Name="SearchResultsBorder" Width="320" Background="{ThemeResource Paper}" BorderBrush="{ThemeResource Rule}" BorderThickness="1" CornerRadius="6" Padding="4" MaxHeight="320">
            <StackPanel x:Name="SearchResults" />
          </Border>
        </Popup>
      </Grid>

      <Border x:Name="LensTabs" Grid.Column="3" Background="{ThemeResource Paper2}" BorderBrush="{ThemeResource Rule}" BorderThickness="1" CornerRadius="7" Padding="2" Height="28" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="LensStructure" ToolTipService.ToolTip="Structure (1)" Content="Structure" Style="{StaticResource LensTab}" Tag="structure" Click="OnLensTab" AutomationProperties.Name="Structure lens" />
          <Button x:Name="LensNavigation" ToolTipService.ToolTip="Navigation (2)" Content="Navigation" Style="{StaticResource LensTab}" Tag="navigation" Click="OnLensTab" AutomationProperties.Name="Navigation lens" />
          <Button x:Name="LensBehavior" ToolTipService.ToolTip="Behavior (3)" Content="Behavior" Style="{StaticResource LensTab}" Tag="behavior" Click="OnLensTab" AutomationProperties.Name="Behavior lens" />
          <Button x:Name="LensStates" ToolTipService.ToolTip="States (4)" Content="States" Style="{StaticResource LensTab}" Tag="states" Click="OnLensTab" AutomationProperties.Name="States lens" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="FidelityButton" ToolTipService.ToolTip="Wireframe or UI previews (W)" Content="Wire" Style="{StaticResource ShellButton}" Click="OnToggleFidelity" AutomationProperties.Name="Wireframe or UI previews (W)" />
        <Button x:Name="ViewButton" ToolTipService.ToolTip="Flat view (F)" Content="Flat" Style="{StaticResource ShellButton}" Click="OnToggleView" AutomationProperties.Name="Flat view (F)" />
        <Button x:Name="MotionButton" ToolTipService.ToolTip="Reduce motion" Content="Motion" Style="{StaticResource ShellButton}" Click="OnToggleMotion" AutomationProperties.Name="Reduce motion" />
        <Button x:Name="ModeButton" ToolTipService.ToolTip="Dock the viewer (D)" Content="Dock" Style="{StaticResource ShellButton}" Click="OnToggleMode" AutomationProperties.Name="Dock the viewer (D)" />
        <Button x:Name="HelpButton" ToolTipService.ToolTip="Shortcuts (?)" Content="?" Style="{StaticResource IconButton}" Click="OnToggleHelp" AutomationProperties.Name="Keyboard shortcuts" />
      </StackPanel>
    </Grid>

    <!-- ========== shell: editor | viewer slot | inspector, with the viewer floating over the grid ========== -->
    <Grid x:Name="Shell" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="EditorColumn" Width="{StaticResource EditorWidth}" />
        <ColumnDefinition x:Name="SlotColumn" Width="*" />
        <ColumnDefinition x:Name="InspectorColumn" Width="{StaticResource InspectorWidth}" />
      </Grid.ColumnDefinitions>

      <!-- mock editor -->
      <Grid x:Name="Editor" Background="{ThemeResource Paper2}" BorderBrush="{ThemeResource Rule}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" BorderBrush="{ThemeResource Rule}" BorderThickness="0,0,0,1" Padding="8">
          <StackPanel x:Name="EditorFiles" />
        </ScrollViewer>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Background="{ThemeResource Paper}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" Padding="0,8">
          <StackPanel x:Name="EditorCode" />
        </ScrollViewer>
      </Grid>

      <Border x:Name="ViewerSlot" Grid.Column="1" />

      <!-- inspector -->
      <ScrollViewer x:Name="InspectorScroll" Grid.Column="2" Background="{ThemeResource Paper}" BorderBrush="{ThemeResource Rule}" BorderThickness="1,0,0,0" VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel x:Name="Inspector" MaxWidth="640" HorizontalAlignment="Left" />
      </ScrollViewer>

      <!-- the viewer and the dock ghost float over the three columns; Dock places them -->
      <Canvas x:Name="Overlay" Grid.ColumnSpan="3">
        <Rectangle x:Name="DockGhost" Stroke="{ThemeResource Ink3}" StrokeThickness="1" RadiusX="8" RadiusY="8" Visibility="Collapsed" IsHitTestVisible="False" />

        <Grid x:Name="Viewer" Background="{ThemeResource Paper}" AutomationProperties.Name="Orbital viewer">
          <ContentControl x:Name="StageHost" IsTabStop="True" UseSystemFocusVisuals="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Orbital viewer">
            <scene:SceneCanvas x:Name="Stage" />
          </ContentControl>

          <local:DragHandle x:Name="ViewerHead" VerticalAlignment="Top" Padding="12,8" ColumnSpacing="12" Background="Transparent" ToolTipService.ToolTip="Drag to dock or undock">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="ViewerGrip" Width="14" Height="10" Opacity="0.55" VerticalAlignment="Center">
              <Ellipse Width="2" Height="2" Fill="{ThemeResource Ink3}" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Ellipse Width="2" Height="2" Fill="{ThemeResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Top" />
              <Ellipse Width="2" Height="2" Fill="{ThemeResource Ink3}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              <Ellipse Width="2" Height="2" Fill="{ThemeResource Ink3}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
              <Ellipse Width="2" Height="2" Fill="{ThemeResource Ink3}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
              <Ellipse Width="2" Height="2" Fill="{ThemeResource Ink3}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
            <Button x:Name="ViewerBack" ToolTipService.ToolTip="Back along your trail (Alt+←)" Grid.Column="1" Content="←" Style="{StaticResource IconButton}" Click="OnBack" AutomationProperties.Name="Back along your trail (Alt+←)" />
            <TextBlock x:Name="ViewerTitle" Grid.Column="2" Style="{StaticResource T12}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="ViewerNote" Grid.Column="3" Style="{StaticResource T11}" Foreground="{ThemeResource Ink3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="ViewerDock" ToolTipService.ToolTip="Dock (D)" Grid.Column="4" Content="⤡" Style="{StaticResource IconButton}" Click="OnToggleMode" AutomationProperties.Name="Dock viewer (D)" />
            <Button x:Name="ViewerExpand" ToolTipService.ToolTip="Expand (D)" Grid.Column="4" Content="⤢" Style="{StaticResource IconButton}" Click="OnToggleMode" Visibility="Collapsed" AutomationProperties.Name="Expand viewer (D)" />
          </local:DragHandle>

          <Grid x:Name="ViewerFoot" VerticalAlignment="Bottom" Padding="12,8" ColumnSpacing="12" IsHitTestVisible="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CameraReadout" Style="{StaticResource Mono11}" Foreground="{ThemeResource Ink3}" VerticalAlignment="Center" />
            <Button x:Name="CameraReset" ToolTipService.ToolTip="Reset camera (0)" Grid.Column="1" Content="reset view" Style="{StaticResource LinkButton}" Click="OnCameraReset" AutomationProperties.Name="Reset camera (0)" />
            <Button x:Name="LayoutReset" ToolTipService.ToolTip="Put moved cards back" Grid.Column="2" Content="reset layout" Style="{StaticResource LinkButton}" Click="OnLayoutReset" Visibility="Collapsed" AutomationProperties.Name="Put moved cards back" />
            <TextBlock Grid.Column="3" Text="wheel to zoom levels · drag the canvas to orbit · drag a card to move it" Style="{StaticResource T11}" Foreground="{ThemeResource Ink3}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Canvas>
    </Grid>

    <!-- load failure: one panel with the asset path -->
    <Grid x:Name="BootError" Grid.RowSpan="2" Background="{ThemeResource Paper}" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="520">
        <TextBlock Text="App Orbit could not read its graph" Style="{StaticResource T20}" />
        <TextBlock x:Name="BootErrorText" Style="{StaticResource T12}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
