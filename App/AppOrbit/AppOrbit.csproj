<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>App Orbit</ApplicationTitle>
    <ApplicationId>com.mattmattei.apporbit</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>App Orbit</ApplicationPublisher>
    <Description>A spatial app inspector: semantic zoom over an app graph, built with Uno Platform.</Description>

    <!--
      SkiaRenderer carries SKCanvasElement, which draws the whole viewer. No MVUX:
      the state is one synchronous store (see SPEC.md, Pattern).
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- One graph for every renderer: the prototype's file, linked, packaged as an asset. -->
    <Content Include="..\..\graph\orderly.graph.json" Link="Graph\orderly.graph.json" />
  </ItemGroup>
</Project>
