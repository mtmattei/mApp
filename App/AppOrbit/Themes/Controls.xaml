<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shell controls at the prototype's one control height (28), rule border, 6px radius. -->


  <Style x:Key="ShellButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2}" />
    <Setter Property="Background" Value="{ThemeResource Paper}" />
    <Setter Property="BorderBrush" Value="{ThemeResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ShellButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="ShellToggle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2}" />
    <Setter Property="Background" Value="{ThemeResource Paper}" />
    <Setter Property="BorderBrush" Value="{ThemeResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- lens tabs: a flat segmented control inside one paper-2 track -->
  <Style x:Key="LensTab" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <!-- link-style buttons (reset view, source refs, breadcrumb) -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource Focus}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CrumbButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- rows in the inspector and the editor: quiet, full width, left aligned -->
  <Style x:Key="RowButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
    <Setter Property="Background" Value="{ThemeResource Paper2}" />
    <Setter Property="BorderBrush" Value="{ThemeResource Rule}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
