<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
      App Orbit tokens: the prototype's css/app-orbit.css :root, one key per custom property.
      Colours sit in ThemeDictionaries and are consumed as ThemeResource; the Skia renderer
      reads the same keys once per theme (Scene/Palette.cs). Sizes and motion are static.
  -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.Paper">#F5F4EF</Color>
      <Color x:Key="Color.Paper2">#ECEBE4</Color>
      <Color x:Key="Color.Paper3">#E3E2DA</Color>
      <Color x:Key="Color.Ink">#1D2430</Color>
      <Color x:Key="Color.Ink2">#4A5160</Color>
      <Color x:Key="Color.Ink3">#7A8190</Color>
      <Color x:Key="Color.Rule">#CFD2D8</Color>
      <Color x:Key="Color.Rule2">#E1E3E7</Color>
      <Color x:Key="Color.Focus">#2457D6</Color>
      <Color x:Key="Color.FocusSoft">#1F2457D6</Color>
      <Color x:Key="Color.Danger">#B4432F</Color>
      <Color x:Key="Color.Ok">#2F7D4F</Color>
      <Color x:Key="Color.Hue.Screen">#1D2430</Color>
      <Color x:Key="Color.Hue.Feature">#5B6472</Color>
      <Color x:Key="Color.Hue.Vm">#4B55B8</Color>
      <Color x:Key="Color.Hue.State">#A66A00</Color>
      <Color x:Key="Color.Hue.Route">#0F7B74</Color>
      <Color x:Key="Color.Hue.Comp">#7A4E8C</Color>
      <Color x:Key="Color.UiAccent">#7A4A2E</Color>
      <Color x:Key="Color.UiAccentSoft">#1F7A4A2E</Color>
      <Color x:Key="Color.Shadow">#40141820</Color>

      <SolidColorBrush x:Key="Paper" Color="{StaticResource Color.Paper}" />
      <SolidColorBrush x:Key="Paper2" Color="{StaticResource Color.Paper2}" />
      <SolidColorBrush x:Key="Paper3" Color="{StaticResource Color.Paper3}" />
      <SolidColorBrush x:Key="Ink" Color="{StaticResource Color.Ink}" />
      <SolidColorBrush x:Key="Ink2" Color="{StaticResource Color.Ink2}" />
      <SolidColorBrush x:Key="Ink3" Color="{StaticResource Color.Ink3}" />
      <SolidColorBrush x:Key="Rule" Color="{StaticResource Color.Rule}" />
      <SolidColorBrush x:Key="Rule2" Color="{StaticResource Color.Rule2}" />
      <SolidColorBrush x:Key="Focus" Color="{StaticResource Color.Focus}" />
      <SolidColorBrush x:Key="FocusSoft" Color="{StaticResource Color.FocusSoft}" />
      <SolidColorBrush x:Key="Danger" Color="{StaticResource Color.Danger}" />
      <SolidColorBrush x:Key="Ok" Color="{StaticResource Color.Ok}" />
      <SolidColorBrush x:Key="Hue.Screen" Color="{StaticResource Color.Hue.Screen}" />
      <SolidColorBrush x:Key="Hue.Feature" Color="{StaticResource Color.Hue.Feature}" />
      <SolidColorBrush x:Key="Hue.Vm" Color="{StaticResource Color.Hue.Vm}" />
      <SolidColorBrush x:Key="Hue.State" Color="{StaticResource Color.Hue.State}" />
      <SolidColorBrush x:Key="Hue.Route" Color="{StaticResource Color.Hue.Route}" />
      <SolidColorBrush x:Key="Hue.Comp" Color="{StaticResource Color.Hue.Comp}" />
      <SolidColorBrush x:Key="UiAccent" Color="{StaticResource Color.UiAccent}" />
      <SolidColorBrush x:Key="UiAccentSoft" Color="{StaticResource Color.UiAccentSoft}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Paper">#15181E</Color>
      <Color x:Key="Color.Paper2">#1C2028</Color>
      <Color x:Key="Color.Paper3">#232834</Color>
      <Color x:Key="Color.Ink">#E8E9EC</Color>
      <Color x:Key="Color.Ink2">#B6BAC4</Color>
      <Color x:Key="Color.Ink3">#848A97</Color>
      <Color x:Key="Color.Rule">#3A3F4A</Color>
      <Color x:Key="Color.Rule2">#2A2F39</Color>
      <Color x:Key="Color.Focus">#7AA2FF</Color>
      <Color x:Key="Color.FocusSoft">#297AA2FF</Color>
      <Color x:Key="Color.Danger">#E0735F</Color>
      <Color x:Key="Color.Ok">#6CC08B</Color>
      <Color x:Key="Color.Hue.Screen">#E8E9EC</Color>
      <Color x:Key="Color.Hue.Feature">#9AA3B2</Color>
      <Color x:Key="Color.Hue.Vm">#9AA3FF</Color>
      <Color x:Key="Color.Hue.State">#E0A93A</Color>
      <Color x:Key="Color.Hue.Route">#4FC1B7</Color>
      <Color x:Key="Color.Hue.Comp">#C08AD6</Color>
      <Color x:Key="Color.UiAccent">#D9A27F</Color>
      <Color x:Key="Color.UiAccentSoft">#2ED9A27F</Color>
      <Color x:Key="Color.Shadow">#B3000000</Color>

      <SolidColorBrush x:Key="Paper" Color="{StaticResource Color.Paper}" />
      <SolidColorBrush x:Key="Paper2" Color="{StaticResource Color.Paper2}" />
      <SolidColorBrush x:Key="Paper3" Color="{StaticResource Color.Paper3}" />
      <SolidColorBrush x:Key="Ink" Color="{StaticResource Color.Ink}" />
      <SolidColorBrush x:Key="Ink2" Color="{StaticResource Color.Ink2}" />
      <SolidColorBrush x:Key="Ink3" Color="{StaticResource Color.Ink3}" />
      <SolidColorBrush x:Key="Rule" Color="{StaticResource Color.Rule}" />
      <SolidColorBrush x:Key="Rule2" Color="{StaticResource Color.Rule2}" />
      <SolidColorBrush x:Key="Focus" Color="{StaticResource Color.Focus}" />
      <SolidColorBrush x:Key="FocusSoft" Color="{StaticResource Color.FocusSoft}" />
      <SolidColorBrush x:Key="Danger" Color="{StaticResource Color.Danger}" />
      <SolidColorBrush x:Key="Ok" Color="{StaticResource Color.Ok}" />
      <SolidColorBrush x:Key="Hue.Screen" Color="{StaticResource Color.Hue.Screen}" />
      <SolidColorBrush x:Key="Hue.Feature" Color="{StaticResource Color.Hue.Feature}" />
      <SolidColorBrush x:Key="Hue.Vm" Color="{StaticResource Color.Hue.Vm}" />
      <SolidColorBrush x:Key="Hue.State" Color="{StaticResource Color.Hue.State}" />
      <SolidColorBrush x:Key="Hue.Route" Color="{StaticResource Color.Hue.Route}" />
      <SolidColorBrush x:Key="Hue.Comp" Color="{StaticResource Color.Hue.Comp}" />
      <SolidColorBrush x:Key="UiAccent" Color="{StaticResource Color.UiAccent}" />
      <SolidColorBrush x:Key="UiAccentSoft" Color="{StaticResource Color.UiAccentSoft}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- type: five sizes, one family. Mono is for refs, members and code. -->
  <FontFamily x:Key="Font.Ui">Segoe UI, system-ui, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

  <Style x:Key="T11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource Ink2}" />
  </Style>
  <Style x:Key="T12" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="T13" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
  </Style>
  <Style x:Key="T15" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
  </Style>
  <Style x:Key="T20" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
  </Style>
  <Style x:Key="Mono11" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource Ink}" />
  </Style>

  <!-- spacing on a 4-pt grid; one radius; one control height -->
  <x:Double x:Key="Space.1">4</x:Double>
  <x:Double x:Key="Space.2">8</x:Double>
  <x:Double x:Key="Space.3">12</x:Double>
  <x:Double x:Key="Space.4">16</x:Double>
  <x:Double x:Key="Space.5">24</x:Double>
  <x:Double x:Key="Space.6">32</x:Double>
  <CornerRadius x:Key="Radius">8</CornerRadius>
  <x:Double x:Key="ControlHeight">28</x:Double>

  <!-- shell geometry -->
  <GridLength x:Key="TopBarHeight">48</GridLength>
  <GridLength x:Key="EditorWidth">300</GridLength>
  <GridLength x:Key="InspectorWidth">320</GridLength>
  <x:Double x:Key="Dock.W">380</x:Double>
  <x:Double x:Key="Dock.H">260</x:Double>
  <x:Double x:Key="Dock.Gap">16</x:Double>

  <!-- motion, in milliseconds; reduced motion resolves each in one step -->
  <x:Double x:Key="Motion.Orbit">420</x:Double>
  <x:Double x:Key="Motion.Fade">180</x:Double>
  <x:Double x:Key="Motion.Hover">120</x:Double>
  <x:Double x:Key="Motion.Draw">240</x:Double>
  <x:Double x:Key="Motion.Dock">260</x:Double>

</ResourceDictionary>
